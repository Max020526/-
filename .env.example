NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Netlify 托管环境必填。仅填写项目 ref（URL 中 .supabase.co 前的部分），不要填写密钥。
# deploy-preview / branch-deploy 会据此阻止误连生产数据库。
PRODUCTION_SUPABASE_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF

# 仅供未来的服务端管理员接口使用；绝不能添加 NEXT_PUBLIC_ 前缀。
# 第一阶段的浏览器和服务端用户会话都不需要此变量。
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
