# Copy to .env.local and replace every REPLACE_ME value. Never commit .env.local.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_SURFACE=admin
NEXT_PUBLIC_APP_NAME=NEXORA Admin Local

# Local development should use Supabase CLI. Remote Staging is allowed only with
# ALLOW_REMOTE_STAGING_FOR_LOCAL=true and must never be the Production project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_OPERATIONS_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001

# Public project refs are isolation guards, not credentials.
PRODUCTION_SUPABASE_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF
STAGING_SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF
# Optional when a PR uses an isolated Supabase Preview Branch.
PREVIEW_SUPABASE_PROJECT_REF=

# Local-only escape hatch for connecting to the remote Staging project.
ALLOW_REMOTE_STAGING_FOR_LOCAL=false

# Server-only values. Never add NEXT_PUBLIC_ and never commit real values.
SUPABASE_SECRET_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_ACCESS_TOKEN=REPLACE_ME
SUPABASE_DB_PASSWORD=REPLACE_ME
DATABASE_URL=REPLACE_ME
NETLIFY_AUTH_TOKEN=REPLACE_ME
NETLIFY_SITE_ID=REPLACE_ME
STRIPE_SECRET_KEY=REPLACE_ME
WEBHOOK_SECRET=REPLACE_ME
