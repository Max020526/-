{
  "name": "nexora-studio-storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:netlify",
    "build": "npm run build:netlify",
    "start": "npm run start:netlify",
    "dev:netlify": "next dev",
    "build:netlify": "npm run verify:environment && next build",
    "start:netlify": "next start",
    "verify:environment": "node scripts/verify-deployment-environment.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/phase3-contracts.test.mjs tests/phase4-contracts.test.mjs tests/formal-sales-phase1.test.mjs && node --experimental-strip-types --test tests/navigation.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "lucide-react": "0.468.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
