{
  "name": "nexora-wholesale-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "dev:netlify": "next dev",
    "build:netlify": "next build",
    "start:netlify": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/database-foundation.test.mjs tests/security-performance-contracts.test.mjs tests/v1-phase1-baseline.test.mjs tests/v1-phase2-product-operations.test.mjs tests/v1-phase3-storefront-orders.test.mjs tests/v1-phase4-order-fulfillment-returns.test.mjs tests/v1-phase5-procurement-finance-pos.test.mjs && node --experimental-strip-types --test tests/parser.test.ts tests/supabase-config.test.ts tests/auth-roles.test.ts tests/inbound-validation.test.ts tests/csv.test.ts tests/friendly-error.test.ts tests/color-display.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern customer-store",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@zxing/browser": "^0.2.1",
    "cross-env": "7.0.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.468.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.5",
    "tesseract.js": "^7.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260731.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
